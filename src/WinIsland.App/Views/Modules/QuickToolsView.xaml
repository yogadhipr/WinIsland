<UserControl x:Class="WinIsland.App.Views.Modules.QuickToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="400">
    <Grid Margin="12,2,12,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Pomodoro Timer -->
        <Border Grid.Column="0" Background="#141418" BorderBrush="#24242C" BorderThickness="1" CornerRadius="10" Padding="8,6">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="POMODORO FOCUS" FontSize="9" FontWeight="Bold" Foreground="#FF453A" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PomoTimeRemaining}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,3"/>

                <!-- Control Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Button Command="{Binding TogglePomoCommand}" Width="24" Height="24" Margin="2,0" Background="#FF453A" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <Path Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Command="{Binding ResetPomoCommand}" Width="24" Height="24" Margin="2,0" Background="#2C2C34" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <Path Fill="#EBEBF5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Preset Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding SetPomoPresetCommand}" CommandParameter="25" Content="25m" FontSize="8" Padding="4,1" Margin="1,0" Background="#202026" Foreground="#AEAEB2" BorderThickness="0" Cursor="Hand"/>
                    <Button Command="{Binding SetPomoPresetCommand}" CommandParameter="15" Content="15m" FontSize="8" Padding="4,1" Margin="1,0" Background="#202026" Foreground="#AEAEB2" BorderThickness="0" Cursor="Hand"/>
                    <Button Command="{Binding SetPomoPresetCommand}" CommandParameter="5" Content="5m" FontSize="8" Padding="4,1" Margin="1,0" Background="#202026" Foreground="#AEAEB2" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Divider -->
        <Border Grid.Column="1" Background="#24242C" Margin="6,0"/>

        <!-- Right: Clipboard History & Telemetry -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Clipboard Header -->
            <Grid Grid.Row="0" Margin="0,0,0,2">
                <TextBlock Text="CLIPBOARD HISTORY (10 RECENT)" FontSize="9" FontWeight="Bold" Foreground="#636366"/>
            </Grid>

            <!-- Clipboard List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ClipboardItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1" Background="#18181E" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="6"
                                    Padding="6,3" Cursor="Hand" ToolTip="Click to re-copy to Windows clipboard"
                                    MouseLeftButtonUp="OnClipboardItemClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TextPreview}" FontSize="10" Foreground="#E5E5EA" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat=HH:mm}" FontSize="8" Foreground="#636366" Margin="4,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Telemetry Mini Bar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                <TextBlock Text="CPU: " FontSize="9" Foreground="#636366"/>
                <TextBlock Text="{Binding CpuText}" FontSize="9" FontWeight="SemiBold" Foreground="#30D158" Margin="0,0,8,0"/>

                <TextBlock Text="RAM: " FontSize="9" Foreground="#636366"/>
                <TextBlock Text="{Binding RamText}" FontSize="9" FontWeight="SemiBold" Foreground="#0A84FF" Margin="0,0,8,0"/>

                <TextBlock Text="BAT: " FontSize="9" Foreground="#636366"/>
                <TextBlock Text="{Binding BatteryText}" FontSize="9" FontWeight="SemiBold" Foreground="#FFD60A"/>
                <TextBlock Text=" ⚡" FontSize="9" Foreground="#30D158" Visibility="{Binding IsChargingGlowVisible, Converter={x:Null}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
