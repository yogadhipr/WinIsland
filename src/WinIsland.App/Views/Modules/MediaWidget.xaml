<UserControl x:Class="WinIsland.App.Views.Modules.MediaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="110" d:DesignWidth="400">
    <Grid Margin="4,2,4,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Squircle Album Artwork (64x64px, CornerRadius 14) -->
        <Border Grid.Column="0"
                Width="64" Height="64"
                CornerRadius="14"
                Background="#16161A"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                ClipToBounds="True"
                VerticalAlignment="Center">
            <Grid>
                <!-- Fallback Vinyl / Note Icon -->
                <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MediaInfo.Thumbnail}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Canvas Width="24" Height="24">
                        <Path Fill="#636366" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,11A1,1 0 0,1 13,12A1,1 0 0,1 12,13A1,1 0 0,1 11,12A1,1 0 0,1 12,11Z"/>
                    </Canvas>
                </Viewbox>
                <!-- Actual Track Thumbnail -->
                <Image Source="{Binding MediaInfo.Thumbnail}" Stretch="UniformToFill"/>
            </Grid>
        </Border>

        <!-- Track Info, Visualizer, Scrubber, & Controls -->
        <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title, Artist, & Visualizer -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MediaInfo.Title, FallbackValue='No Media Playing'}" 
                               FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis" MaxWidth="220" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding MediaInfo.Artist, FallbackValue='System Audio Idle'}" 
                               FontSize="11" FontWeight="Normal" Foreground="#8E8E93"
                               TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,1,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Audio Visualizer in top right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Height="14" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="Bar1" Width="2.5" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="5"/>
                    <Border x:Name="Bar2" Width="2.5" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="12"/>
                    <Border x:Name="Bar3" Width="2.5" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="14"/>
                    <Border x:Name="Bar4" Width="2.5" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="9"/>
                    <Border x:Name="Bar5" Width="2.5" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="6"/>
                    <Border x:Name="Bar6" Width="2.5" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="11"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Thin Scrubber Bar (4px) -->
            <Grid Grid.Row="1" Height="4" Margin="0,8,0,8">
                <Border Background="#20FFFFFF" CornerRadius="2"/>
                <Border Background="#E5E5EA" CornerRadius="2" HorizontalAlignment="Left" Width="100"/>
            </Grid>

            <!-- Row 2: Media Control Buttons (Proportional) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Prev Button -->
                <Button Command="{Binding PrevTrackCommand}" Width="28" Height="28" Margin="8,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="14">
                                <Path Fill="#C7C7CC" HorizontalAlignment="Center" VerticalAlignment="Center" Width="12" Height="12" Stretch="Uniform"
                                      Data="M6,6H8V18H6M9.5,12L18,18V6L9.5,12Z"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBg" Property="Background" Value="#18FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Play / Pause Button (Proportional 32x32) -->
                <Button Command="{Binding TogglePlayPauseCommand}" Width="32" Height="32" Margin="8,0" Cursor="Hand" Background="#FFFFFF" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PlayBg" Background="{TemplateBinding Background}" CornerRadius="16">
                                <Path x:Name="PlayIcon" Fill="#050505" HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="11" Stretch="Uniform"
                                      Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PlayBg" Property="Background" Value="#F2F2F7"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding MediaInfo.IsPlaying}" Value="True">
                                    <Setter TargetName="PlayIcon" Property="Data" Value="M14,19H18V5H14M6,19H10V5H6V19Z"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Next Button -->
                <Button Command="{Binding NextTrackCommand}" Width="28" Height="28" Margin="8,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="14">
                                <Path Fill="#C7C7CC" HorizontalAlignment="Center" VerticalAlignment="Center" Width="12" Height="12" Stretch="Uniform"
                                      Data="M16,18H18V6H16M6,6L14.5,12L6,18V6Z"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBg" Property="Background" Value="#18FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
