<Window x:Class="WinIsland.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:modules="clr-namespace:WinIsland.App.Views.Modules"
        xmlns:vm="clr-namespace:WinIsland.App.ViewModels"
        mc:Ignorable="d"
        Title="WinIsland Overlay"
        Height="240" Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SegmentedPillButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="10,4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#E5E5EA"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#24FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Center">
        <Border x:Name="MainIslandBorder"
                Width="248"
                Height="38"
                CornerRadius="19"
                Background="#050505"
                BorderBrush="#18FFFFFF"
                BorderThickness="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                ClipToBounds="False"
                MouseEnter="OnCapsuleMouseEnter"
                MouseLeave="OnCapsuleMouseLeave"
                PreviewMouseWheel="OnCapsuleMouseWheel"
                AllowDrop="True"
                DragEnter="OnCapsuleDragEnter"
                DragLeave="OnCapsuleDragLeave"
                Drop="OnCapsuleDrop">

            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="28"
                                  ShadowDepth="4"
                                  Opacity="0.75"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- COMPACT VIEW -->
                <Grid x:Name="CompactView" Height="38" Margin="12,0" VerticalAlignment="Center" Visibility="Visible" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="PixelPetCompactIcon" Width="24" Height="20" VerticalAlignment="Center" Margin="0,0,6,0">
                            <modules:PixelPetCanvas Width="24" Height="18" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel x:Name="MiniAudioVisualizer" Orientation="Horizontal" Height="12" VerticalAlignment="Center" Margin="2,0,0,0">
                            <Border x:Name="MiniBar1" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="5"/>
                            <Border x:Name="MiniBar2" Width="2" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="9"/>
                            <Border x:Name="MiniBar3" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="7"/>
                            <Border x:Name="MiniBar4" Width="2" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="4"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="40" Background="Transparent" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactClockText"
                                   Text="{Binding CurrentTimeString}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <Border x:Name="CompactBatteryBadge"
                                Background="#1C1C1E"
                                BorderBrush="#2C2C34"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="5,2"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BatteryText}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#30D158"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="⚡"
                                           FontSize="8"
                                           Foreground="#30D158"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsChargingGlowVisible, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- EXPANDED VIEW -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- ROW 0: UNIFIED HEADER -->
                    <Grid Grid.Row="0" Margin="12,6,12,0">
                        <Border Background="#121215"
                                CornerRadius="11"
                                Padding="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Music" Tag="Media" IsChecked="True" Style="{StaticResource SegmentedPillButtonStyle}" Click="OnTabSelected"/>
                                <RadioButton Content="Files" Tag="FileShelf" Style="{StaticResource SegmentedPillButtonStyle}" Click="OnTabSelected"/>
                                <RadioButton Content="Tools" Tag="QuickTools" Style="{StaticResource SegmentedPillButtonStyle}" Click="OnTabSelected"/>
                                <RadioButton Content="Settings" Tag="Settings" Style="{StaticResource SegmentedPillButtonStyle}" Click="OnTabSelected"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTimeString}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#E5E5EA"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <Border Background="#1C1C1E"
                                    BorderBrush="#2C2C34"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BatteryText}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#30D158"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="⚡"
                                               FontSize="9"
                                               Foreground="#30D158"
                                               Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsChargingGlowVisible, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <Button Click="OnMinimizeClicked"
                                    Width="22" Height="22"
                                    Background="#1C1C22"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Minimize">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MinBorder" Background="{TemplateBinding Background}" CornerRadius="11">
                                            <TextBlock Text="—"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#8E8E93"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,-2,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MinBorder" Property="Background" Value="#2C2C36"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: CONTENT AREA -->
                    <Grid Grid.Row="1" Margin="14,4,14,4">
                        <modules:MediaWidget x:Name="MediaTabContent" Visibility="Visible"/>
                        <modules:FileDropZone x:Name="FileShelfTabContent" Visibility="Collapsed"/>
                        <modules:QuickToolsView x:Name="QuickToolsTabContent" Visibility="Collapsed"/>
                        <modules:SettingsView x:Name="SettingsTabContent" Visibility="Collapsed"/>
                    </Grid>

                    <!-- ROW 2: DEDICATED PIXEL PET TRACK -->
                    <Border Grid.Row="2" Height="22" VerticalAlignment="Bottom" BorderThickness="0,1,0,0" BorderBrush="#12FFFFFF" Margin="12,0,12,2">
                        <Canvas x:Name="PetTrackCanvas" Height="22" ClipToBounds="True">
                            <Canvas x:Name="WalkingPetContainer" Canvas.Left="10" Canvas.Top="0">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="PetWalkTransform" X="0"/>
                                </Canvas.RenderTransform>
                                <modules:PixelPetCanvas Width="26" Height="20" VerticalAlignment="Center"/>
                            </Canvas>
                        </Canvas>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
