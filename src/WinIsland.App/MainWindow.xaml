<Window x:Class="WinIsland.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:modules="clr-namespace:WinIsland.App.Views.Modules"
        xmlns:vm="clr-namespace:WinIsland.App.ViewModels"
        mc:Ignorable="d"
        Title="WinIsland Dynamic Island"
        Height="270" Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- macOS Segmented Pill Button Template -->
        <Style x:Key="SegmentedPillButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="9,3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#E5E5EA"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#24FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Glass Circle Button (30x30px transparent glass, white icon) -->
        <Style x:Key="GlassCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CircleBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                BorderBrush="#18FFFFFF"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CircleBorder" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CircleBorder" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CircleBorder" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Media Control Button Style -->
        <Style x:Key="MediaControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Thin Slider Style (Track Height 4px, 12px circular white thumb, smooth click & drag) -->
        <Style x:Key="MacThinSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#2C2C2E" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="20" VerticalAlignment="Center">
                                                    <Border Height="4" CornerRadius="2" Background="#E5E5EA" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="20" VerticalAlignment="Center">
                                                    <Border Height="4" Background="Transparent" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent" Width="16" Height="20">
                                                    <Border Width="12" Height="12" CornerRadius="6" Background="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.4"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Toggle Switch Style (34x18px pill switch) -->
        <Style x:Key="MacToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="34" Height="18" VerticalAlignment="Center">
                                <Border x:Name="SwitchTrack" Width="34" Height="18" CornerRadius="9" Background="#3A3A3C"/>
                                <Border x:Name="SwitchThumb" Width="14" Height="14" CornerRadius="7" Background="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#30D158"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Center">
        <!-- Main Floating Capsule (Deep Matte Black #050505, Margin 0,12,0,0 with 1px border and deep drop shadow) -->
        <Border x:Name="MainIslandBorder"
                Width="210"
                Height="38"
                CornerRadius="20"
                Background="#050505"
                BorderBrush="#18FFFFFF"
                BorderThickness="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,12,0,0"
                ClipToBounds="False"
                MouseEnter="OnMainIslandMouseEnter"
                MouseLeave="OnMainIslandMouseLeave"
                PreviewMouseWheel="OnMainIslandMouseWheel"
                PreviewMouseRightButtonDown="OnMainIslandPreviewMouseRightButtonDown"
                PreviewMouseRightButtonUp="OnMainIslandPreviewMouseRightButtonUp"
                AllowDrop="True"
                DragEnter="OnMainIslandDragEnter"
                DragLeave="OnMainIslandDragLeave"
                Drop="OnMainIslandDrop">

            <!-- Deep Matte Black Drop Shadow -->
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="28"
                                  ShadowDepth="4"
                                  Opacity="0.75"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- COMPACT VIEW: PixelPetCompactIcon, MiniAudioVisualizer, Pomodoro Countdown badge, 30px notch room, clock, and battery badge -->
                <Grid x:Name="CompactView" Height="38" Margin="10,0" VerticalAlignment="Center" Visibility="Visible" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: PixelPetCompactIcon, CompactVisualizer & Pomodoro Countdown Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="PixelPetCompactIcon" Width="24" Height="20" VerticalAlignment="Center" Margin="0,0,5,0">
                            <modules:PixelPetCanvas Width="24" Height="18" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel x:Name="CompactVisualizer" Orientation="Horizontal" Height="12" VerticalAlignment="Center" Margin="2,0,0,0">
                            <Border x:Name="MiniBar1" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="5"/>
                            <Border x:Name="MiniBar2" Width="2" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="9"/>
                            <Border x:Name="MiniBar3" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="7"/>
                            <Border x:Name="MiniBar4" Width="2" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="4"/>
                        </StackPanel>

                        <!-- Compact Pomodoro Badge (Shown only when timer running) -->
                        <Border x:Name="CompactPomodoroBadge" Background="#1FFF453A" CornerRadius="5" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Stroke="#FF453A" StrokeThickness="1.2" Width="7" Height="7" Stretch="Uniform" Margin="0,0,3,0"
                                      Data="M 4,1 A 3,3 0 1,1 3.99,1 Z M 4,1 V 4 L 6,4"/>
                                <TextBlock Text="{Binding PomoTimeRemaining}" FontSize="9" FontWeight="Bold" Foreground="#FF453A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center: Notch Breathing Room -->
                    <Border Grid.Column="1" Width="30" Background="Transparent" HorizontalAlignment="Center"/>

                    <!-- Right: CompactClockText & CompactBatteryBadge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactClockText"
                                   Text="{Binding CurrentTimeString}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Border x:Name="CompactBatteryBadge"
                                Background="#12FFFFFF"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="5,2"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CompactBatteryText"
                                           Text="{Binding BatteryText}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#EBEBF5"
                                           VerticalAlignment="Center"/>
                                <!-- Monochrome Thin Charging Bolt Path (No emoji) -->
                                <Path x:Name="CompactChargingBoltPath"
                                      Width="7" Height="9"
                                      Stretch="Uniform"
                                      Stroke="#30D158"
                                      StrokeThickness="1.2"
                                      Fill="#30D158"
                                      Margin="3,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      Data="M 3.5,0.5 L 1,5.2 H 3.5 L 2.8,9.5 L 6.8,4.5 H 4.2 Z"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- EXPANDED VIEW: 3-Row Grid layout (Row 0: Unified Header, Row 1: Content Area, Row 2: Dedicated Pixel Pet Track) -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Unified Header -->
                        <RowDefinition Height="36"/>
                        <!-- Row 1: Content Area -->
                        <RowDefinition Height="*"/>
                        <!-- Row 2: Dedicated Pixel Pet Track -->
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- ROW 0: UNIFIED HEADER -->
                    <Grid Grid.Row="0" Margin="12,5,12,0">
                        <!-- Left: macOS Segmented Pill Control -->
                        <Border Background="#121215"
                                CornerRadius="10"
                                Padding="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MusicTabRadio" Content="Music" Tag="Media" IsChecked="True" Style="{StaticResource SegmentedPillButtonStyle}" Click="OnTabSelected"/>
                                <RadioButton x:Name="FilesTabRadio" Content="Files" Tag="FileShelf" Style="{StaticResource SegmentedPillButtonStyle}" Click="OnTabSelected"/>
                                <RadioButton x:Name="ToolsTabRadio" Content="Tools" Tag="QuickTools" Style="{StaticResource SegmentedPillButtonStyle}" Click="OnTabSelected"/>
                                <RadioButton x:Name="SettingsTabRadio" Content="Settings" Tag="Settings" Style="{StaticResource SegmentedPillButtonStyle}" Click="OnTabSelected"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Clock, Monochrome Battery Badge, Minimize Button (—) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTimeString}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#E5E5EA"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <Border x:Name="ExpandedBatteryBadge"
                                    Background="#12FFFFFF"
                                    BorderBrush="#1FFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExpandedBatteryText"
                                               Text="{Binding BatteryText}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#EBEBF5"
                                               VerticalAlignment="Center"/>
                                    <!-- Monochrome Thin Charging Bolt Path (No emoji) -->
                                    <Path x:Name="ExpandedChargingBoltPath"
                                          Width="8" Height="10"
                                          Stretch="Uniform"
                                          Stroke="#30D158"
                                          StrokeThickness="1.2"
                                          Fill="#30D158"
                                          Margin="3,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"
                                          Data="M 3.5,0.5 L 1,5.2 H 3.5 L 2.8,9.5 L 6.8,4.5 H 4.2 Z"/>
                                </StackPanel>
                            </Border>

                            <!-- Minimize Button (—) -->
                            <Button Click="OnMinimizeClicked"
                                    Width="22" Height="22"
                                    Background="#1C1C22"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Minimize to Compact View">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MinBorder" Background="{TemplateBinding Background}" CornerRadius="11">
                                            <TextBlock Text="—"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#8E8E93"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,-2,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MinBorder" Property="Background" Value="#2C2C36"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: CONTENT AREA -->
                    <Grid Grid.Row="1" Margin="14,2,14,2">
                        <!-- TAB 1: MUSIC CONTENT -->
                        <Grid x:Name="MediaTabContent" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top Section: Media Card (Artwork, Details / Placeholder, Controls) -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Squircle Album Artwork (60x60px, CornerRadius 12) -->
                                <Border x:Name="AlbumArtBorder"
                                        Grid.Column="0"
                                        Width="60" Height="60"
                                        CornerRadius="12"
                                        Background="#16161A"
                                        BorderBrush="#20FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <!-- Fallback Vinyl / Note Icon -->
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MediaInfo.Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#636366" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,11A1,1 0 0,1 13,12A1,1 0 0,1 12,13A1,1 0 0,1 11,12A1,1 0 0,1 12,11Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <!-- Track Thumbnail -->
                                        <Image Source="{Binding MediaInfo.Thumbnail}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <!-- Track Details, Visualizer, Scrubber, & Balanced Controls -->
                                <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top: Song Title, Artist & Audio Visualizer in top right -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Active Media Info -->
                                        <StackPanel x:Name="ActiveMediaDetails" Grid.Column="0" VerticalAlignment="Center" Visibility="Visible">
                                            <TextBlock Text="{Binding MediaInfo.Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="230"/>
                                            <TextBlock Text="{Binding MediaInfo.Artist}"
                                                       FontSize="10"
                                                       FontWeight="Normal"
                                                       Foreground="#8E8E93"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="230"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- No Media Placeholder (Centered empty state when !hasActiveMedia) -->
                                        <StackPanel x:Name="NoMediaPlaceholder" Grid.Column="0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="No Media Playing"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Open Spotify or browser to play audio"
                                                       FontSize="10"
                                                       FontWeight="Normal"
                                                       Foreground="#8E8E93"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Expanded Audio Visualizer -->
                                        <StackPanel x:Name="ExpandedVisualizer" Grid.Column="1" Orientation="Horizontal" Height="14" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border x:Name="EqBar1" Width="2.5" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="5"/>
                                            <Border x:Name="EqBar2" Width="2.5" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="12"/>
                                            <Border x:Name="EqBar3" Width="2.5" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="14"/>
                                            <Border x:Name="EqBar4" Width="2.5" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="9"/>
                                            <Border x:Name="EqBar5" Width="2.5" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="6"/>
                                            <Border x:Name="EqBar6" Width="2.5" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Middle: Interactive Progress Scrubber Bar with left & right time duration -->
                                    <Grid x:Name="MediaProgressBar" Grid.Row="1" Margin="0,6,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtCurrentTime" Text="00:00" MinWidth="28" FontSize="9" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Grid Grid.Column="1" x:Name="ScrubberTrackContainer" Height="14" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                              MouseLeftButtonDown="OnScrubberMouseDown"
                                              MouseMove="OnScrubberMouseMove"
                                              MouseLeftButtonUp="OnScrubberMouseUp"
                                              MouseEnter="OnScrubberMouseEnter"
                                              MouseLeave="OnScrubberMouseLeave">
                                            <Border x:Name="ScrubberTrackBackground" Height="4" Background="#20FFFFFF" CornerRadius="2" VerticalAlignment="Center" ClipToBounds="True">
                                                <Border x:Name="ScrubberFill" Background="#E5E5EA" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="2" x:Name="TxtRemainingTime" Text="-00:00" MinWidth="32" TextAlignment="Right" FontSize="9" Foreground="#8E8E93" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- Bottom: Proportionally Balanced Controls (Prev, 30x30 Glass Play/Pause, Next) -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Prev Track -->
                                        <Button x:Name="BtnPrevTrack" Command="{Binding PrevTrackCommand}" Width="28" Height="28" Margin="6,0" Style="{StaticResource MediaControlButtonStyle}">
                                            <Path Fill="#C7C7CC" HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="11" Stretch="Uniform"
                                                  Data="M 3,3.5 V 10.5 M 10.5,3.5 L 4.5,7 L 10.5,10.5 Z"/>
                                        </Button>

                                        <!-- Play / Pause Button (Transparent Glass Button 30x30px) -->
                                        <Button x:Name="BtnPlayPause" Command="{Binding TogglePlayPauseCommand}" Style="{StaticResource GlassCircleButtonStyle}" Margin="6,0">
                                            <Path x:Name="PlayPauseGlyph" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10" Stretch="Uniform"
                                                  Data="M 5,3.5 L 11.5,7.5 L 5,11.5 Z"/>
                                        </Button>

                                        <!-- Next Track -->
                                        <Button x:Name="BtnNextTrack" Command="{Binding NextTrackCommand}" Width="28" Height="28" Margin="6,0" Style="{StaticResource MediaControlButtonStyle}">
                                            <Path Fill="#C7C7CC" HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="11" Stretch="Uniform"
                                                  Data="M 11,3.5 V 10.5 M 3.5,3.5 L 9.5,7 L 3.5,10.5 Z"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Bottom Section: Minimalist Dual Controls (Volume & Brightness with MacThinSliderStyle) -->
                            <Border Grid.Row="1" Background="#0CFFFFFF" CornerRadius="7" Padding="8,3" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Volume Control -->
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Thin Speaker Path (Monochrome, no emoji) -->
                                        <Path Width="12" Height="12" VerticalAlignment="Center" Stroke="#8E8E93" StrokeThickness="1.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                              Data="M 1,4 H 3.5 L 7,1 V 11 L 3.5,8 H 1 Z M 9,3.5 C 10.5,5 10.5,7 9,8.5"/>
                                        <!-- Mac Thin Slider -->
                                        <Slider Grid.Column="1" x:Name="VolumeSlider" Style="{StaticResource MacThinSliderStyle}"
                                                Minimum="0" Maximum="100" Value="50" Margin="6,0" VerticalAlignment="Center"
                                                ValueChanged="OnVolumeSliderValueChanged"/>
                                        <!-- Volume Percent Text -->
                                        <TextBlock Grid.Column="2" x:Name="TxtVolumePercent" Text="50%" FontSize="9" Foreground="#8E8E93"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Right: Brightness Control -->
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Thin Sun Path (Monochrome, no emoji) -->
                                        <Path Width="12" Height="12" VerticalAlignment="Center" Stroke="#8E8E93" StrokeThickness="1.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                              Data="M 6,3 A 3,3 0 1,1 5.99,3 Z M 6,0.5 V 1.8 M 6,10.2 V 11.5 M 0.5,6 H 1.8 M 10.2,6 H 11.5 M 2.1,2.1 L 3,3 M 9,9 L 9.9,9.9 M 2.1,9.9 L 3,9 M 9,3 L 9.9,2.1"/>
                                        <!-- Mac Thin Slider -->
                                        <Slider Grid.Column="1" x:Name="BrightnessSlider" Style="{StaticResource MacThinSliderStyle}"
                                                Minimum="0" Maximum="100" Value="75" Margin="6,0" VerticalAlignment="Center"
                                                ValueChanged="OnBrightnessSliderValueChanged"/>
                                        <!-- Brightness Percent Text -->
                                        <TextBlock Grid.Column="2" x:Name="TxtBrightnessPercent" Text="75%" FontSize="9" Foreground="#8E8E93"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 2: FILES (TRANSIT SHELF) -->
                        <Grid x:Name="FileShelfTabContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Shelf Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="FILE TRANSIT SHELF (OLE DRAG &amp; DROP)" FontSize="9" FontWeight="Bold" Foreground="#636366" VerticalAlignment="Center"/>
                                <Button x:Name="ClearFilesButton" Click="OnClearFilesClicked" Content="Clear All" FontSize="9"
                                        Foreground="#8E8E93" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"/>
                            </Grid>

                            <!-- Content Box -->
                            <Border Grid.Row="1" Background="#141418" BorderBrush="#24242C" BorderThickness="1" CornerRadius="10" Padding="8">
                                <Grid>
                                    <!-- Empty State Drop Target -->
                                    <StackPanel x:Name="EmptyFilesView" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Path Stroke="#636366" StrokeThickness="1.2" Fill="Transparent" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                              Data="M 2,4 C 2,2.9 2.9,2 4,2 H 7 L 9,4 H 14 C 15.1,4 16,4.9 16,6 V 12 C 16,13.1 15.1,14 14,14 H 4 C 2.9,14 2,13.1 2,12 Z"/>
                                        <TextBlock x:Name="EmptyFilesText" Text="Drop files here to hold" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- List of Stored Files -->
                                    <ScrollViewer x:Name="FilesListScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  HorizontalAlignment="Stretch" Visibility="Collapsed">
                                        <ItemsControl ItemsSource="{Binding FileItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,0" Background="#1E1E24" BorderBrush="#383842" BorderThickness="1" CornerRadius="8"
                                                            Padding="8,4" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click and drag out to copy to other apps"
                                                            PreviewMouseLeftButtonDown="OnFileCardMouseDown"
                                                            PreviewMouseMove="OnFileCardMouseMove">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center" MaxWidth="90">
                                                                <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding FileSizeFormatted}" FontSize="9" Foreground="#8E8E93"/>
                                                            </StackPanel>
                                                            <Button Command="{Binding DataContext.RemoveFileItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Margin="6,0,0,0" Width="16" Height="16" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="#2A2A32" CornerRadius="8">
                                                                            <TextBlock Text="×" FontSize="10" Foreground="#C7C7CC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TAB 3: TOOLS (POMODORO & CLIPBOARD) -->
                        <Grid x:Name="QuickToolsTabContent" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Pomodoro Timer -->
                            <Border Grid.Column="0" Background="#141418" BorderBrush="#24242C" BorderThickness="1" CornerRadius="10" Padding="8,5">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="POMODORO FOCUS" FontSize="9" FontWeight="Bold" Foreground="#FF453A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PomoTimeRemaining}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,1,0,3"/>

                                    <!-- Control Buttons (30x30 glass button, 12px white icon) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <Button x:Name="BtnPomodoroPlay" Click="OnPomodoroPlayClicked" Style="{StaticResource GlassCircleButtonStyle}" Width="30" Height="30" Margin="3,0">
                                            <Path x:Name="PomodoroPlayGlyph" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform"
                                                  Data="M 5,3.5 L 11.5,7.5 L 5,11.5 Z"/>
                                        </Button>
                                        <Button Click="OnPomodoroResetClicked" Style="{StaticResource GlassCircleButtonStyle}" Width="26" Height="26" Margin="3,0">
                                            <Path Stroke="#8E8E93" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" Fill="Transparent"
                                                  Data="M 2,6 A 4,4 0 1,1 6,10 L 4.8,8.8"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Preset Buttons (Hidden when running) -->
                                    <StackPanel x:Name="PomodoroPresetPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding SetPomoPresetCommand}" CommandParameter="25" Content="25m" FontSize="8" Padding="5,1" Margin="1,0" Background="#202026" Foreground="#AEAEB2" BorderThickness="0" Cursor="Hand"/>
                                        <Button Command="{Binding SetPomoPresetCommand}" CommandParameter="15" Content="15m" FontSize="8" Padding="5,1" Margin="1,0" Background="#202026" Foreground="#AEAEB2" BorderThickness="0" Cursor="Hand"/>
                                        <Button Command="{Binding SetPomoPresetCommand}" CommandParameter="5" Content="5m" FontSize="8" Padding="5,1" Margin="1,0" Background="#202026" Foreground="#AEAEB2" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Divider -->
                            <Border Grid.Column="1" Background="#24242C" Margin="6,0"/>

                            <!-- Right: Clipboard History & Telemetry -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Clipboard Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                    <TextBlock Text="CLIPBOARD HISTORY (10 RECENT)" FontSize="9" FontWeight="Bold" Foreground="#636366"/>
                                </Grid>

                                <!-- Clipboard List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ClipboardList" ItemsSource="{Binding ClipboardItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,1" Background="#18181E" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="6"
                                                        Padding="6,3" Cursor="Hand" ToolTip="Click to re-copy to Windows clipboard"
                                                        MouseLeftButtonUp="OnClipboardItemClick">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 22x22px Thumbnail Image if item is image -->
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4" Background="#24242A" Margin="0,0,6,0" ClipToBounds="True"
                                                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                                            <Image Source="{Binding ImagePreview}" Stretch="UniformToFill" Width="22" Height="22"/>
                                                        </Border>

                                                        <!-- Text: If IsImage, show 'Image Copied', else TextPreview -->
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10" Foreground="#E5E5EA" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding TextPreview}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                            <Setter Property="Text" Value="Image Copied"/>
                                                                            <Setter Property="Foreground" Value="#0A84FF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Timestamp -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat=HH:mm}" FontSize="8" Foreground="#636366" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Telemetry Mini Bar (Monochrome thin paths, no emojis!) -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="CPU " FontSize="8" FontWeight="SemiBold" Foreground="#636366"/>
                                    <TextBlock Text="{Binding CpuText}" FontSize="8" FontWeight="SemiBold" Foreground="#30D158" Margin="0,0,6,0"/>

                                    <TextBlock Text="RAM " FontSize="8" FontWeight="SemiBold" Foreground="#636366"/>
                                    <TextBlock Text="{Binding RamText}" FontSize="8" FontWeight="SemiBold" Foreground="#0A84FF" Margin="0,0,6,0"/>

                                    <TextBlock Text="BAT " FontSize="8" FontWeight="SemiBold" Foreground="#636366"/>
                                    <TextBlock Text="{Binding BatteryText}" FontSize="8" FontWeight="SemiBold" Foreground="#FFD60A"/>
                                    <Path Width="6" Height="8" Stretch="Uniform" Stroke="#30D158" StrokeThickness="1.2" Fill="#30D158" Margin="2,0,0,0"
                                          Visibility="{Binding IsChargingGlowVisible, Converter={StaticResource BoolToVis}}"
                                          Data="M 3.5,0.5 L 1,5.2 H 3.5 L 2.8,9.5 L 6.8,4.5 H 4.2 Z"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- TAB 4: SETTINGS -->
                        <Grid x:Name="SettingsTabContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="WINISLAND PREFERENCES" FontSize="9" FontWeight="Bold" Foreground="#636366" Margin="0,0,0,4"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Vertical">
                                    <!-- Switches using MacToggleSwitchStyle (34x18px) -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox x:Name="ChkAutoHide" Style="{StaticResource MacToggleSwitchStyle}" Content="Fullscreen Auto-Hide" FontSize="10" Foreground="#E5E5EA"
                                                  IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                        <CheckBox Grid.Column="1" x:Name="ChkRequireAlt" Style="{StaticResource MacToggleSwitchStyle}" Content="Require Alt Key" FontSize="10" Foreground="#E5E5EA"
                                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    </Grid>

                                    <!-- Hover Trigger Delay Slider using MacThinSliderStyle -->
                                    <Grid Margin="0,5,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hover Delay:" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderHoverDelay" Style="{StaticResource MacThinSliderStyle}"
                                                Minimum="100" Maximum="600" Value="250" SmallChange="50" LargeChange="100"
                                                TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                                                ValueChanged="OnSliderDelayChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtDelayValue" Text="250ms" FontSize="10" Foreground="#30D158"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Ghost Opacity (Click-Through) Slider in Tab Settings -->
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Width="11" Height="11" VerticalAlignment="Center" Stroke="#8E8E93" StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Margin="0,0,5,0"
                                                  Data="M 1.5,5.5 C 1.5,3 3,1.5 5.5,1.5 C 8,1.5 9.5,3 9.5,5.5 C 9.5,8 8,9.5 5.5,9.5 C 3,9.5 1.5,8 1.5,5.5 Z M 5.5,3.5 A 2,2 0 1,0 5.5,7.5 A 2,2 0 1,0 5.5,3.5 Z"/>
                                            <TextBlock Text="Ghost Opacity:" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center"
                                                       ToolTip="Transparansi saat Ghost Mode / Click-Through aktif (Hold Ctrl / Klik Kanan Tahan)"/>
                                        </StackPanel>
                                        <Slider Grid.Column="1" x:Name="SettingsGhostOpacitySlider" Style="{StaticResource MacThinSliderStyle}"
                                                Minimum="5" Maximum="80" Value="15" SmallChange="5" LargeChange="10"
                                                TickFrequency="5" IsSnapToTickEnabled="True" Margin="8,0" VerticalAlignment="Center"
                                                ValueChanged="OnGhostOpacitySliderValueChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtSettingsGhostOpacityPercent" Text="15%" FontSize="10" Foreground="#30D158"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Display Target Monitor (Primary vs Active Cursor Monitor) -->
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Width="11" Height="11" VerticalAlignment="Center" Stroke="#8E8E93" StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Margin="0,0,5,0"
                                                  Data="M 1,2 H 10 V 8 H 1 Z M 3.5,10 H 7.5 M 5.5,8 V 10"/>
                                            <TextBlock Text="Display:" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton x:Name="RadioDisplayPrimary" Content="Primary Monitor" GroupName="DisplayTargetGroup"
                                                         Style="{StaticResource SegmentedPillButtonStyle}" FontSize="9" Margin="0,0,3,0"
                                                         Click="OnDisplayTargetChanged"/>
                                            <RadioButton x:Name="RadioDisplayCursor" Content="Active Cursor Monitor" GroupName="DisplayTargetGroup"
                                                         Style="{StaticResource SegmentedPillButtonStyle}" FontSize="9"
                                                         Click="OnDisplayTargetChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Run on Windows Startup -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkStartup" Style="{StaticResource MacToggleSwitchStyle}" Content="Run on Windows Startup" FontSize="10" Foreground="#E5E5EA"
                                                  Checked="OnStartupToggled" Unchecked="OnStartupToggled"/>
                                        <TextBlock Grid.Column="1" Text="Saved automatically" FontSize="8" Foreground="#30D158" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ROW 2: DEDICATED PIXEL PET TRACK (22px) -->
                    <Border Grid.Row="2" Height="22" VerticalAlignment="Bottom" BorderThickness="0,1,0,0" BorderBrush="#12FFFFFF" Margin="12,0,12,2">
                        <Canvas x:Name="PetTrackCanvas" Height="22" ClipToBounds="True">
                            <Canvas x:Name="WalkingPetContainer" Canvas.Left="10" Canvas.Top="0">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="PetWalkTransform" X="0"/>
                                </Canvas.RenderTransform>
                                <modules:PixelPetCanvas Width="26" Height="20" VerticalAlignment="Center"/>
                            </Canvas>
                        </Canvas>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
