<Window x:Class="WinIsland.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinIsland.App.ViewModels"
        mc:Ignorable="d"
        Title="WinIsland Dynamic Island"
        Height="320" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Minimalist Modern ScrollBar Thumb Style -->
        <Style x:Key="MinimalScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="#32FFFFFF"
                                CornerRadius="2.5"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Modern ScrollBar Style (Applies globally to all ScrollViewers) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Margin" Value="3,2,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MinimalScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="5"/>
                    <Setter Property="MinHeight" Value="5"/>
                    <Setter Property="Margin" Value="2,3,2,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MinimalScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Time Picker Pill Segment Button Style -->
        <Style x:Key="TimeSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegBd" Property="Background" Value="#343444"/>
                                <Setter TargetName="SegBd" Property="BorderBrush" Value="#30D158"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegBd" Property="Background" Value="#1E30D158"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Segmented Pill Button Template -->
        <Style x:Key="SegmentedPillButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="7,2.5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#E5E5EA"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carousel Chevron Button Style (< and >) -->
        <Style x:Key="CarouselChevronButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChevronBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChevronBorder" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChevronBorder" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Capsule Action Button Style (e.g. [ Add Task ], [ Short Break ]) -->
        <Style x:Key="DarkCapsuleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="#C7C7CC"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2C2C30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#161618"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Media Button Style (Clean white vector without big white circle) -->
        <Style x:Key="CleanMediaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Micro Dock Icon Button Style -->
        <Style x:Key="MicroDockButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DockBtnBorder" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DockBtnBorder" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Center">
        <!-- Main Floating Capsule (Deep Matte Black #050507, Margin 0,12,0,0 with 1px border and deep drop shadow) -->
        <Border x:Name="MainIslandBorder"
                Width="240"
                Height="38"
                CornerRadius="22"
                Background="#050507"
                BorderBrush="#18FFFFFF"
                BorderThickness="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,12,0,0"
                ClipToBounds="False"
                MouseEnter="OnMainIslandMouseEnter"
                MouseLeave="OnMainIslandMouseLeave"
                MouseWheel="OnMainIslandMouseWheel"
                PreviewMouseRightButtonDown="OnMainIslandPreviewMouseRightButtonDown"
                PreviewMouseRightButtonUp="OnMainIslandPreviewMouseRightButtonUp"
                AllowDrop="True"
                DragEnter="OnMainIslandDragEnter"
                DragLeave="OnMainIslandDragLeave"
                Drop="OnMainIslandDrop">

            <!-- Deep Matte Black Drop Shadow -->
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="32"
                                  ShadowDepth="5"
                                  Opacity="0.85"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Ambient Bottom Glow Layer (Warm amber/album gradient when lyrics or notification active) -->
                <Border x:Name="AmbientBottomGlow"
                        VerticalAlignment="Bottom"
                        Height="85"
                        CornerRadius="0,0,30,30"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00000000" Offset="0.0"/>
                            <GradientStop Color="#CC9A4820" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ========================================== -->
                <!-- COMPACT VIEW: Standard Pill & Toast Modes  -->
                <!-- ========================================== -->
                <Grid x:Name="CompactView" Height="38" Margin="14,0" VerticalAlignment="Center" Visibility="Visible" Opacity="1">
                    <!-- 1. Standard Compact Mode View -->
                    <Grid x:Name="CompactStandardContent" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Compact Icon, Visualizer & Pomodoro Countdown Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Clean Vector Pet/Note Icon -->
                            <Path Width="14" Height="14" Fill="#30D158" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Data="M 7,1 C 4,1 2,3 2,6 C 2,9 5,12 7,13 C 9,12 12,9 12,6 C 12,3 10,1 7,1 Z"/>

                            <!-- Mini 4-Bar Equalizer -->
                            <StackPanel x:Name="CompactVisualizer" Orientation="Horizontal" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border x:Name="MiniBar1" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="5"/>
                                <Border x:Name="MiniBar2" Width="2" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="9"/>
                                <Border x:Name="MiniBar3" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="7"/>
                                <Border x:Name="MiniBar4" Width="2" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="4"/>
                            </StackPanel>

                            <!-- Compact Pomodoro Badge (Shown only when timer running) -->
                            <Border x:Name="CompactPomodoroBadge" Background="#1FFF453A" CornerRadius="6" Padding="6,2" Margin="2,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Stroke="#FF453A" StrokeThickness="1.2" Width="7" Height="7" Stretch="Uniform" Margin="0,0,4,0"
                                          Data="M 4,1 A 3,3 0 1,1 3.99,1 Z M 4,1 V 4 L 6,4"/>
                                    <TextBlock Text="{Binding PomoTimeRemaining}" FontSize="9.5" FontWeight="Bold" Foreground="#FF453A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Center: Notch Breathing Room -->
                        <Border Grid.Column="1" MinWidth="20" Background="Transparent" HorizontalAlignment="Stretch"/>

                        <!-- Right: CompactClockText & CompactBatteryBadge -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CompactClockText"
                                       Text="{Binding CurrentTimeString}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <Border x:Name="CompactBatteryBadge"
                                     Background="#12FFFFFF"
                                     BorderBrush="#1FFFFFFF"
                                     BorderThickness="1"
                                     CornerRadius="6"
                                     Padding="6,2"
                                     VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CompactBatteryText"
                                               Text="{Binding BatteryText}"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               Foreground="#EBEBF5"
                                               VerticalAlignment="Center"/>
                                    <!-- Monochrome Thin Charging Bolt Path -->
                                    <Path x:Name="CompactChargingBoltPath"
                                          Width="7" Height="9"
                                          Stretch="Uniform"
                                          Stroke="#30D158"
                                          StrokeThickness="1.2"
                                          Fill="#30D158"
                                          Margin="3,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"
                                          Data="M 3.5,0.5 L 1,5.2 H 3.5 L 2.8,9.5 L 6.8,4.5 H 4.2 Z"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Live Notification Toast Row (Width 350, Height 58, 3.5s auto-dismiss) -->
                    <Grid x:Name="CompactToastContent" Visibility="Collapsed" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OnCompactToastBodyClicked">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Badge / Icon -->
                        <Border x:Name="CompactToastBadgeBorder" Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#1E30D158" VerticalAlignment="Center" Margin="2,0,10,0">
                            <TextBlock x:Name="CompactToastAppInitial" Text="W" FontWeight="Bold" FontSize="14" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title & Message Snippet -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CompactToastSender" Text="WhatsApp" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CompactToastTime" Text="now" FontSize="9" Foreground="#8E8E93" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="CompactToastMessage" Text="Sarah Miller: Hey, check this build!" FontSize="10" Foreground="#D1D1D6" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Dismiss Button (×) -->
                        <Button x:Name="CompactToastDismissBtn" Grid.Column="2" Click="OnDismissToastClicked" Width="22" Height="22" Background="#1C1C1E" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                        <TextBlock Text="×" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- EXPANDED VIEW: Unified Carousel & MicroDock-->
                <!-- ========================================== -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Center Status Header & Top Right Visualizer (38px) -->
                        <RowDefinition Height="38"/>
                        <!-- Row 1: Carousel Content Area with Dedicated Chevron Columns (*) -->
                        <RowDefinition Height="*"/>
                        <!-- Row 2: Morphing Bottom Pagination Dots <-> Micro Dock (32px) -->
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <!-- ROW 0: TOP CENTER STATUS HEADER & TOP RIGHT AUDIO WAVEFORM (3 Non-Overlapping Columns) -->
                    <Grid Grid.Row="0" Margin="18,8,18,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="115"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left (Col 0): Transient HUD Feedback Pill (Volume / Brightness / Actions) -->
                        <Border x:Name="HudFeedbackBadge"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#26FFFFFF"
                                CornerRadius="8"
                                Padding="8,2.5"
                                Visibility="Collapsed">
                            <TextBlock x:Name="HudFeedbackText"
                                       Text="🔊 50%"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- Center (Col 1): Mini Circular Progress Ring + Real-Time Date & Time Text -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Mini Circular Progress Ring (14x14px, red/orange #FF3B30) -->
                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Stroke="#2C2C2E" StrokeThickness="2"/>
                                <Path x:Name="TopMiniProgressArc"
                                      Stroke="#FF3B30"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 7,1 A 6,6 0 1,1 6.99,1"/>
                            </Grid>

                            <!-- Date Text ("Sat 24 Oct 2026") -->
                            <TextBlock x:Name="HeaderDateText"
                                       Text="{Binding TopHeaderDateText}"
                                       FontSize="12"
                                       Foreground="#EBEBF5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>

                            <!-- Time Text ("12:42" Bold White) -->
                            <TextBlock x:Name="HeaderTimeText"
                                       Text="{Binding TopHeaderTimeText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right (Col 2): 5-Bar Audio Waveform Visualizer & Minimize Button (—) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Audio Waveform (5 vertical bars) -->
                            <StackPanel x:Name="ExpandedVisualizer" Orientation="Horizontal" Height="15" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Border x:Name="EqBar1" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="5"/>
                                <Border x:Name="EqBar2" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="11"/>
                                <Border x:Name="EqBar3" Width="2" Margin="1,0" CornerRadius="1" Background="#30D158" VerticalAlignment="Bottom" Height="15"/>
                                <Border x:Name="EqBar4" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="9"/>
                                <Border x:Name="EqBar5" Width="2" Margin="1,0" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Bottom" Height="5"/>
                            </StackPanel>

                            <!-- Minimize Button (—) -->
                            <Button Click="OnMinimizeClicked"
                                    Width="20" Height="20"
                                    Background="#1A1A1E"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Minimize to Compact Capsule">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MinBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                            <TextBlock Text="—" FontSize="9" FontWeight="Bold" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MinBorder" Property="Background" Value="#2C2C36"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: CAROUSEL CONTENT AREA WITH DEDICATED CHEVRON COLUMNS (< and >) -->
                    <Grid Grid.Row="1" Margin="6,2,6,4">
                        <Grid.ColumnDefinitions>
                            <!-- Dedicated Left Chevron Column -->
                            <ColumnDefinition Width="36"/>
                            <!-- Dedicated Slide Content Column (Never overlaps Chevrons!) -->
                            <ColumnDefinition Width="*"/>
                            <!-- Dedicated Right Chevron Column -->
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Chevron Button (<) -->
                        <Button x:Name="PrevSlideBtn"
                                Grid.Column="0"
                                Style="{StaticResource CarouselChevronButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="OnPrevSlideClicked"
                                ToolTip="Previous Slide">
                            <Path Data="M 13,6 L 8,11 L 13,16"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>

                        <!-- Center Carousel Host (5 SLIDES) -->
                        <Grid x:Name="CarouselHost" Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center" ClipToBounds="True">

                            <!-- ======================================================== -->
                            <!-- SLIDE 0: MUSIC PLAYER + SPLIT-VIEW SYNCED LYRICS         -->
                            <!-- ======================================================== -->
                            <Grid x:Name="SlideMusic" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <!-- Player Column (*) -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Split-View Lyrics Column (Auto) -->
                                    <ColumnDefinition x:Name="LyricsSplitColumn" Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Music Player Area -->
                                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="4,0,4,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Album Artwork + Title & Artist -->
                                    <Grid Grid.Row="0" Margin="8,0,8,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Album Artwork (58x58, CornerRadius 12) -->
                                        <Border x:Name="AlbumArtBorder"
                                                Grid.Column="0"
                                                Width="58" Height="58"
                                                CornerRadius="12"
                                                Background="#16161A"
                                                BorderBrush="#25FFFFFF"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <!-- Fallback Vinyl / Note Icon -->
                                                <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox.Style>
                                                        <Style TargetType="Viewbox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MediaInfo.Thumbnail}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Viewbox.Style>
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#636366" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,11A1,1 0 0,1 13,12A1,1 0 0,1 12,13A1,1 0 0,1 11,12A1,1 0 0,1 12,11Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <Image Source="{Binding MediaInfo.Thumbnail}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <!-- Song Title & Artist -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSongTitle"
                                                       Text="{Binding MediaInfo.Title, TargetNullValue='No Media Playing'}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtSongArtist"
                                                       Text="{Binding MediaInfo.Artist, TargetNullValue='Ready for playback'}"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="#8E8E93"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: Interactive Scrubber ("01:53", Progress Bar, "-01:52") -->
                                    <Grid Grid.Row="1" Margin="8,0,8,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtCurrentTime" Text="00:00" MinWidth="34" FontSize="11" Foreground="#D1D1D6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Grid Grid.Column="1" x:Name="ScrubberTrackContainer" Height="16" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                              MouseLeftButtonDown="OnScrubberMouseDown"
                                              MouseMove="OnScrubberMouseMove"
                                              MouseLeftButtonUp="OnScrubberMouseUp"
                                              MouseEnter="OnScrubberMouseEnter"
                                              MouseLeave="OnScrubberMouseLeave">
                                            <Border x:Name="ScrubberTrackBackground" Height="4" Background="#48484A" CornerRadius="2" VerticalAlignment="Center" ClipToBounds="True">
                                                <Border x:Name="ScrubberFill" Background="#FFFFFF" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="2" x:Name="TxtRemainingTime" Text="-00:00" MinWidth="38" TextAlignment="Right" FontSize="11" Foreground="#D1D1D6" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>

                                    <!-- Row 2: Controls Row (Lyrics Balon, Clean Prev/Play/Next, Volume) -->
                                    <Grid Grid.Row="2" Margin="8,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Kiri: Lyrics Balon Kutipan Button (💬) -->
                                        <Button x:Name="LyricsToggleBtn"
                                                Grid.Column="0"
                                                Click="OnLyricsToggleClicked"
                                                Width="30" Height="30"
                                                Style="{StaticResource CleanMediaButtonStyle}"
                                                ToolTip="Toggle Live Synced Lyrics">
                                            <Border x:Name="LyricsToggleBorder" Background="#14FFFFFF" CornerRadius="15" Padding="6">
                                                <Path x:Name="LyricsQuoteGlyph"
                                                      Fill="#8E8E93"
                                                      Width="14" Height="14"
                                                      Stretch="Uniform"
                                                      Data="M 3,4 C 3,2.9 3.9,2 5,2 H 15 C 16.1,2 17,2.9 17,4 V 12 C 17,13.1 16.1,14 15,14 H 7 L 3,18 Z M 7,6 H 8.5 M 11.5,6 H 13 M 7,9 H 13"/>
                                            </Border>
                                        </Button>

                                        <!-- Tengah: Clean Vector Playback Buttons (Well-Spaced) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Prev -->
                                            <Button x:Name="PrevMediaBtn" Command="{Binding PrevTrackCommand}" Width="30" Height="30" Margin="10,0" Style="{StaticResource CleanMediaButtonStyle}" ToolTip="Previous Track">
                                                <Path Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="13" Height="13" Stretch="Uniform"
                                                      Data="M 3,3.5 V 10.5 M 10.5,3.5 L 4.5,7 L 10.5,10.5 Z"/>
                                            </Button>

                                            <!-- Play / Pause -->
                                            <Button x:Name="PlayPauseMediaBtn" Command="{Binding TogglePlayPauseCommand}" Width="34" Height="34" Margin="10,0" Style="{StaticResource CleanMediaButtonStyle}" ToolTip="Play / Pause">
                                                <Path x:Name="PlayPauseGlyph" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15" Stretch="Uniform"
                                                      Data="M 5,3.5 L 11.5,7.5 L 5,11.5 Z"/>
                                            </Button>

                                            <!-- Next -->
                                            <Button x:Name="NextMediaBtn" Command="{Binding NextTrackCommand}" Width="30" Height="30" Margin="10,0" Style="{StaticResource CleanMediaButtonStyle}" ToolTip="Next Track">
                                                <Path Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="13" Height="13" Stretch="Uniform"
                                                      Data="M 11,3.5 V 10.5 M 3.5,3.5 L 9.5,7 L 3.5,10.5 Z"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Kanan: Volume Icon Button (🔊) -->
                                        <Button x:Name="VolumeMuteBtn"
                                                Grid.Column="2"
                                                Click="OnVolumeIconClicked"
                                                Width="30" Height="30"
                                                Style="{StaticResource CleanMediaButtonStyle}"
                                                ToolTip="Click to Mute/Unmute • Scroll Wheel for Volume (Shift+Scroll for Brightness)">
                                            <Path x:Name="VolumeIconPath"
                                                  Width="14" Height="14" VerticalAlignment="Center" Stroke="#8E8E93" StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                                  Data="M 1,4 H 3.5 L 7,1 V 11 L 3.5,8 H 1 Z M 9,3.5 C 10.5,5 10.5,7 9,8.5"/>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- Column 1: Conditional Split-View Live Synced Lyrics -->
                                <Border x:Name="LyricsPanel"
                                        Grid.Column="1"
                                        Width="220"
                                        Height="134"
                                        Margin="14,0,2,0"
                                        Background="#121216"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14,12"
                                        Visibility="Collapsed">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Baris Lirik Aktif (Bound to ActiveLyricLine) -->
                                        <TextBlock x:Name="TxtActiveLyrics"
                                                   Grid.Row="0"
                                                   Text="{Binding ActiveLyricLine}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"
                                                   LineHeight="19"/>

                                        <!-- Baris Lirik Berikutnya (Bound to NextLyricLine) -->
                                        <TextBlock x:Name="TxtNextLyrics"
                                                   Grid.Row="1"
                                                   Text="{Binding NextLyricLine}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#78FFFFFF"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="38"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ======================================================== -->
                            <!-- SLIDE 1: POMODORO TIMER                                  -->
                            <!-- ======================================================== -->
                            <Grid x:Name="SlidePomodoro" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Title "Pomodoro" -->
                                <TextBlock Grid.Row="0" Text="Pomodoro" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="12,0,0,8"/>

                                <!-- Row 1: Left Circular Ring (82x82) + Right Big Time (25:00) with generous gap -->
                                <Grid Grid.Row="1" Margin="12,0,12,12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Red Circular Ring (82x82, Stroke 7px #FF2D55) -->
                                    <Grid Grid.Column="0" Width="82" Height="82" Margin="20,0,28,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <!-- Background Ring -->
                                        <Ellipse Stroke="#2C2C2E" StrokeThickness="7"/>

                                        <!-- Animated Progress Arc -->
                                        <Path x:Name="PomodoroProgressArc"
                                              Stroke="#FF2D55"
                                              StrokeThickness="7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M 41,3.5 A 37.5,37.5 0 1,1 40.99,3.5"/>

                                        <!-- Stopwatch Vector Glyph in Center -->
                                        <Path Stroke="#FFFFFF" StrokeThickness="2.5" Fill="Transparent" Width="24" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M 8,2 H 12 M 10,2 V 4 M 10,7 V 11 L 13,11 M 10,4 A 7,7 0 1,1 9.99,4 Z"/>
                                    </Grid>

                                    <!-- Right: Big Time 25:00, Reset Button, Subtitle -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Big Time: 25:00 (34px Bold White, MouseWheel +/- 1m) -->
                                            <TextBlock x:Name="PomodoroTimeText"
                                                       Text="{Binding PomoTimeRemaining, TargetNullValue='25:00'}"
                                                       FontSize="34"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"
                                                       Cursor="Hand"
                                                       PreviewMouseWheel="OnPomodoroTimeMouseWheel"
                                                       MouseLeftButtonUp="OnPomodoroTimeClicked"
                                                       ToolTip="Scroll wheel to adjust (+/- 1m, Shift+Scroll for +/- 5m). Click to type custom minutes."/>

                                            <!-- Inline Custom Minutes Editor -->
                                            <Border x:Name="PomodoroEditBorder"
                                                    Background="#1C1C22"
                                                    BorderBrush="#FF2D55"
                                                    BorderThickness="1.5"
                                                    CornerRadius="8"
                                                    Padding="6,2"
                                                    Visibility="Collapsed"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox x:Name="TxtPomodoroMinutesInput"
                                                             Width="48"
                                                             FontSize="22"
                                                             FontWeight="Bold"
                                                             Foreground="#FFFFFF"
                                                             CaretBrush="#FF2D55"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             TextAlignment="Center"
                                                             MaxLength="3"
                                                             KeyDown="OnPomodoroMinutesKeyDown"
                                                             LostFocus="OnPomodoroMinutesLostFocus"/>
                                                    <TextBlock Text="min" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Bottom" Margin="2,0,2,3"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Reset Button (↻) -->
                                            <Button x:Name="ResetPomodoroBtn"
                                                    Click="OnPomodoroResetClicked"
                                                    Width="26" Height="26"
                                                    Margin="10,0,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Reset Timer">
                                                <Path Stroke="#8E8E93" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Fill="Transparent"
                                                      Data="M 2,6 A 4,4 0 1,1 6,10 L 4.8,8.8"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Subtitle: "Focus time" -->
                                        <TextBlock Text="{Binding PomoModeName, TargetNullValue='Focus time'}" FontSize="12" Foreground="#8E8E93" Margin="2,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: 3 Capsule Buttons with generous spacing -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <!-- 1. [ ☕ Short Break ] -->
                                    <Button Click="OnPomodoroShortBreakClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Margin="6,0" Padding="12,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="☕" FontSize="10" Margin="0,0,5,0"/>
                                            <TextBlock Text="Short Break" FontSize="10"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Center: Red Accent [ ▶ ] -->
                                    <Button Click="OnPomodoroPlayClicked" Width="56" Height="28" Margin="6,0" Cursor="Hand" BorderThickness="0" Background="Transparent" Style="{StaticResource CleanMediaButtonStyle}">
                                        <Border x:Name="PlayBorder" Background="#FF3B30" CornerRadius="14" Width="56" Height="28">
                                            <Path x:Name="PomodoroPlayGlyph" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="11" Stretch="Uniform"
                                                  Data="M 5,3.5 L 11.5,7.5 L 5,11.5 Z"/>
                                        </Border>
                                    </Button>

                                    <!-- 3. [ 🎯 Focus Time ] -->
                                    <Button Click="OnPomodoroFocusClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Margin="6,0" Padding="12,5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontSize="10" Margin="0,0,5,0"/>
                                            <TextBlock Text="Focus Time" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- ======================================================== -->
                            <!-- SLIDE 2: TODOLIST + EXPANDABLE CALENDAR (FILE TRAY LAYOUT)-->
                            <!-- ======================================================== -->
                            <Grid x:Name="SlideTodoList" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="CalendarColumn" Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- COLUMN 0: 3-Row Fundamental Layout (Same as File Tray) -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Title "TodoList" + Compact Date & Progress Status Badge -->
                                    <Grid Grid.Row="0" Margin="4,0,4,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Todo" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="List" FontSize="15" FontWeight="Bold" Foreground="#30D158" Margin="3,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TodoDateSubtitleText}" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#1E30D158" BorderBrush="#4430D158" BorderThickness="1" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TodoRatioText" Text="{Binding TodoProgressText, TargetNullValue='0/0'}" FontSize="10" FontWeight="Bold" Foreground="#30D158"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: Full-Width Task List Box (Height 92, same as File Tray) -->
                                    <Border x:Name="TodoListContainerBorder"
                                            Grid.Row="1"
                                            Background="#101014"
                                            BorderBrush="#1CFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,6"
                                            Height="92"
                                            Margin="4,0,4,10"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <!-- Empty State for Selected Date (Clickable to add task) -->
                                            <Border Background="Transparent"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="OnEmptyTodoAreaClicked"
                                                    Visibility="{Binding HasNoTasksForSelectedDate, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Klik untuk menambah jadwal baru">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Path Stroke="#8E8E93" StrokeThickness="1.3" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"
                                                          Data="M 2,4 C 2,2.9 2.9,2 4,2 H 10 C 11.1,2 12,2.9 12,4 V 10 C 12,11.1 11.1,12 10,12 H 4 C 2.9,12 2,11.1 2,10 Z M 4,7 L 6,9 L 10,4"/>
                                                    <TextBlock Text="Belum ada jadwal di tanggal ini (klik ⊕ Add Task untuk menambah)" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <ScrollViewer x:Name="TodoScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding FilteredTodoTasks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Full-Width Task Item Card -->
                                                            <Border x:Name="TaskRowBorder" Margin="0,2.5" CornerRadius="9" Padding="10,5.5" Cursor="Hand" MouseLeftButtonUp="OnTaskItemClicked">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#16161C"/>
                                                                        <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="Background" Value="#1630D158"/>
                                                                                <Setter Property="BorderBrush" Value="#3830D158"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#22222C"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Checkbox Circle -->
                                                                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="Transparent"/>
                                                                                <Setter Property="BorderBrush" Value="{Binding CategoryColor}"/>
                                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                        <Setter Property="Background" Value="#30D158"/>
                                                                                        <Setter Property="BorderBrush" Value="#30D158"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Path Width="8" Height="6" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                            <Path.Data>M 1,3 L 3.5,5.5 L 7,1</Path.Data>
                                                                        </Path>
                                                                    </Border>

                                                                    <!-- Task Title (Full Horizontal Space) -->
                                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#8E8E93"/>
                                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <!-- Schedule Badge Pill -->
                                                                    <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="6" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplaySchedule}" FontSize="9.5" Foreground="#C7C7CC"/>
                                                                    </Border>

                                                                    <!-- Edit (✎) & Delete (×) Row Actions -->
                                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Click="OnEditSingleTaskClicked" Tag="{Binding}" Width="18" Height="18" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Edit Task">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="Bd" Background="#24FFFFFF" CornerRadius="9">
                                                                                        <TextBlock Text="✎" FontSize="9" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="Bd" Property="Background" Value="#30D158"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                        <Button Click="OnDeleteSingleTaskClicked" Tag="{Binding}" Width="18" Height="18" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Delete Task">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="Bd" Background="#24FFFFFF" CornerRadius="9">
                                                                                        <TextBlock Text="×" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="Bd" Property="Background" Value="#FF453A"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <!-- Row 2: Bottom Quick Action Buttons (File Tray Fundamental Style) -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                        <Button Click="OnAddTaskClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="⊕ Add Task" Margin="5,0" ToolTip="Tambah jadwal baru"/>
                                        <Button x:Name="EditTaskModeBtn" Click="OnEditTaskClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="✎ Edit" Margin="5,0" ToolTip="Edit jadwal"/>
                                        <Button x:Name="CalendarToggleBtn" Click="OnCalendarToggleClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Margin="5,0" ToolTip="Toggle Calendar &amp; 24h Timeline">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="CalBorder" Background="Transparent" CornerRadius="4" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Path x:Name="CalGlyph" Stroke="#8E8E93" StrokeThickness="1.3" Width="11" Height="11" Stretch="Uniform" Fill="Transparent"
                                                          Data="M 2,4 C 2,2.9 2.9,2 4,2 H 12 C 13.1,2 14,2.9 14,4 V 12 C 14,13.1 13.1,14 12,14 H 4 C 2.9,14 2,13.1 2,12 Z M 2,6 H 14 M 5,1 V 3 M 11,1 V 3"/>
                                                </Border>
                                                <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnClearCompletedTasksClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="Clear Done" Margin="5,0" ToolTip="Hapus jadwal yang sudah selesai"/>
                                    </StackPanel>

                                    <!-- Inline Add / Edit Task Modal Panel (Spans Row 1 & Row 2 for spacious editing) -->
                                    <Border x:Name="TaskEditorPanel"
                                            Grid.Row="1"
                                            Grid.RowSpan="2"
                                            Height="132"
                                            Margin="4,0,4,0"
                                            Background="#14141A"
                                            BorderBrush="#30D158"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12,8"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <!-- Row 0: Header Left + Interactive Date Picker Right -->
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtTaskEditorHeader" Grid.Column="0" Text="Add Task" FontSize="11" FontWeight="Bold" Foreground="#30D158" VerticalAlignment="Center"/>

                                                    <!-- Interactive Date Selector Pill (Scroll or Click ‹ / › or Click Calendar) -->
                                                    <Border Grid.Column="1" HorizontalAlignment="Right" Background="#22222A" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,2"
                                                            PreviewMouseWheel="OnTaskDateSelectorWheel"
                                                            ToolTip="Pilih Tanggal (Klik ‹ / ›, Scroll Mouse, atau Klik Tanggal di Kalender)">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Click="OnTaskDatePrevClicked" Content="‹" Width="15" Height="15" FontSize="10.5" Foreground="#C7C7CC" Style="{StaticResource CleanMediaButtonStyle}"/>
                                                            <TextBlock x:Name="TxtTaskEditorDate" Text="25 Oct 2026" FontSize="10" FontWeight="SemiBold" Foreground="#EBEBF5" Margin="6,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OnTaskDateTextClicked"/>
                                                            <Button Click="OnTaskDateNextClicked" Content="›" Width="15" Height="15" FontSize="10.5" Foreground="#C7C7CC" Style="{StaticResource CleanMediaButtonStyle}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Row 1: Task Title Input -->
                                                <Border Background="#22222A" CornerRadius="6" Padding="8,4.5" Margin="0,0,0,6">
                                                    <TextBox x:Name="TxtTaskTitleInput"
                                                             FontSize="11.5"
                                                             Foreground="#FFFFFF"
                                                             CaretBrush="#30D158"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             KeyDown="OnTaskEditorKeyDown"
                                                             ToolTip="Nama Tugas / Jadwal"/>
                                                </Border>

                                                <!-- Row 2: Non-Text Interactive Time Picker + Category Color Picker + Save/Cancel -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Interactive Start & End Time Picker (Click to open Grid Picker OR Scroll MouseWheel) -->
                                                    <Border Grid.Column="0" Background="#1C1C24" CornerRadius="6" Padding="6,2.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Start Hour : Start Minute -->
                                                            <Button x:Name="BtnStartHour" Content="08" Style="{StaticResource TimeSegmentButtonStyle}" Click="OnTimeSegmentClicked" PreviewMouseWheel="OnTimeSegmentMouseWheel" Tag="StartHour" ToolTip="Jam Mulai (Klik untuk pilih atau Scroll Mouse)"/>
                                                            <TextBlock Text=":" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" Margin="2,0" VerticalAlignment="Center"/>
                                                            <Button x:Name="BtnStartMin" Content="00" Style="{StaticResource TimeSegmentButtonStyle}" Click="OnTimeSegmentClicked" PreviewMouseWheel="OnTimeSegmentMouseWheel" Tag="StartMin" ToolTip="Menit Mulai (Klik untuk pilih atau Scroll Mouse)"/>

                                                            <TextBlock Text="–" FontSize="10" FontWeight="Bold" Foreground="#636366" Margin="5,0" VerticalAlignment="Center"/>

                                                            <!-- End Hour : End Minute -->
                                                            <Button x:Name="BtnEndHour" Content="17" Style="{StaticResource TimeSegmentButtonStyle}" Click="OnTimeSegmentClicked" PreviewMouseWheel="OnTimeSegmentMouseWheel" Tag="EndHour" ToolTip="Jam Selesai (Klik untuk pilih atau Scroll Mouse)"/>
                                                            <TextBlock Text=":" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" Margin="2,0" VerticalAlignment="Center"/>
                                                            <Button x:Name="BtnEndMin" Content="00" Style="{StaticResource TimeSegmentButtonStyle}" Click="OnTimeSegmentClicked" PreviewMouseWheel="OnTimeSegmentMouseWheel" Tag="EndMin" ToolTip="Menit Selesai (Klik untuk pilih atau Scroll Mouse)"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Category Color Dots -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Border x:Name="ColorDotGreen" Width="13" Height="13" CornerRadius="6.5" Background="#30D158" Margin="2.5,0" Cursor="Hand" MouseLeftButtonUp="OnTaskColorSelected" Tag="#30D158" BorderBrush="White" BorderThickness="1.5"/>
                                                        <Border x:Name="ColorDotBlue" Width="13" Height="13" CornerRadius="6.5" Background="#0A84FF" Margin="2.5,0" Cursor="Hand" MouseLeftButtonUp="OnTaskColorSelected" Tag="#0A84FF"/>
                                                        <Border x:Name="ColorDotOrange" Width="13" Height="13" CornerRadius="6.5" Background="#FF9F0A" Margin="2.5,0" Cursor="Hand" MouseLeftButtonUp="OnTaskColorSelected" Tag="#FF9F0A"/>
                                                        <Border x:Name="ColorDotPurple" Width="13" Height="13" CornerRadius="6.5" Background="#BF5AF2" Margin="2.5,0" Cursor="Hand" MouseLeftButtonUp="OnTaskColorSelected" Tag="#BF5AF2"/>
                                                    </StackPanel>

                                                    <!-- Save / Cancel Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Click="OnCancelTaskEditorClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="Cancel" Padding="10,4" FontSize="9.5" Margin="0,0,6,0"/>
                                                        <Button Click="OnSaveTaskEditorClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="✓ Save" Foreground="#30D158" Padding="10,4" FontSize="9.5"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Interactive Grid Overlay for Picking Hours (00-23) or Minutes (00-55) Without Typing -->
                                            <Border x:Name="TimePickerOverlayBorder"
                                                    Background="#F716161E"
                                                    BorderBrush="#38FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8,5"
                                                    Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="2,0,2,4">
                                                        <TextBlock x:Name="TxtTimePickerOverlayTitle" Text="Pilih Jam Mulai" FontSize="9.5" FontWeight="Bold" Foreground="#30D158" VerticalAlignment="Center"/>
                                                        <Button Click="OnCloseTimePickerOverlayClicked" Content="×" Width="16" Height="16" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Right" Style="{StaticResource CleanMediaButtonStyle}"/>
                                                    </Grid>
                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <UniformGrid x:Name="TimePickerValuesGrid" Columns="8"/>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- COLUMN 1: CONDITIONAL EXPANDABLE CALENDAR & 24H TIMELINE (Width 215) -->
                                <Border x:Name="CalendarExpandPanel"
                                        Grid.Column="1"
                                        Width="215"
                                        Height="152"
                                        Margin="10,0,0,0"
                                        Background="#121216"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12,8"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Month Header & [ Week | Month ] Capsule Toggle -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtCalendarMonthYear" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                <Button Click="OnCalendarPrevClicked" Content="‹" Width="16" Height="16" Margin="4,0,1,0" FontSize="11" Foreground="#C7C7CC" Style="{StaticResource CleanMediaButtonStyle}" ToolTip="Previous"/>
                                                <Button Click="OnCalendarNextClicked" Content="›" Width="16" Height="16" FontSize="11" Foreground="#C7C7CC" Style="{StaticResource CleanMediaButtonStyle}" ToolTip="Next"/>
                                            </StackPanel>

                                            <!-- Toggle [ Week | Month ] -->
                                            <Border Grid.Column="1" HorizontalAlignment="Right" Background="#1C1C1E" CornerRadius="9" Padding="2" Margin="6,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RbCalendarWeek" Content="Week" IsChecked="True" Checked="OnCalendarModeChanged" Style="{StaticResource SegmentedPillButtonStyle}"/>
                                                    <RadioButton x:Name="RbCalendarMonth" Content="Month" Checked="OnCalendarModeChanged" Style="{StaticResource SegmentedPillButtonStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: 7-Day Day Names (S M T W T F S) -->
                                        <UniformGrid Grid.Row="1" Columns="7" Margin="0,2">
                                            <TextBlock Text="S" FontSize="8.5" FontWeight="SemiBold" Foreground="#636366" HorizontalAlignment="Center"/>
                                            <TextBlock Text="M" FontSize="8.5" FontWeight="SemiBold" Foreground="#636366" HorizontalAlignment="Center"/>
                                            <TextBlock Text="T" FontSize="8.5" FontWeight="SemiBold" Foreground="#636366" HorizontalAlignment="Center"/>
                                            <TextBlock Text="W" FontSize="8.5" FontWeight="SemiBold" Foreground="#636366" HorizontalAlignment="Center"/>
                                            <TextBlock Text="T" FontSize="8.5" FontWeight="SemiBold" Foreground="#636366" HorizontalAlignment="Center"/>
                                            <TextBlock Text="F" FontSize="8.5" FontWeight="SemiBold" Foreground="#636366" HorizontalAlignment="Center"/>
                                            <TextBlock Text="S" FontSize="8.5" FontWeight="SemiBold" Foreground="#636366" HorizontalAlignment="Center"/>
                                        </UniformGrid>

                                        <!-- Row 2: Dynamic Week / Month Dates Grid -->
                                        <UniformGrid x:Name="CalendarDatesGrid" Grid.Row="2" Columns="7" Margin="0,3,0,6"/>

                                        <!-- Row 3: Dynamic 24-Hour Timeline Bar (00 06 12 18 24) -->
                                        <StackPanel x:Name="TimelineSectionPanel" Grid.Row="3" Margin="0,2,0,0">
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="00" FontSize="8.5" Foreground="#636366" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="06" FontSize="8.5" Foreground="#636366" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="2" Text="12" FontSize="8.5" Foreground="#636366" HorizontalAlignment="Left"/>
                                                <Grid Grid.Column="3">
                                                    <TextBlock Text="18" FontSize="8.5" Foreground="#636366" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="24" FontSize="8.5" Foreground="#636366" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Grid>
                                            <!-- Dynamic Track with Tasks Pills & White Current Time Marker -->
                                            <Grid x:Name="TimelineTrackHost" Height="12" HorizontalAlignment="Stretch">
                                                <Border Height="4" CornerRadius="2" Background="#24242A" VerticalAlignment="Center"/>
                                                <Canvas x:Name="TimelinePillsCanvas" Height="12" VerticalAlignment="Center" ClipToBounds="True"/>
                                                <!-- White Current Time Line -->
                                                <Border x:Name="TimelineCurrentTimeLine" HorizontalAlignment="Left" Width="2" Height="10" CornerRadius="1" Background="#FFFFFF" VerticalAlignment="Center" ToolTip="Current Time"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ======================================================== -->
                            <!-- SLIDE 3: NOTIFICATION CENTER (FILE TRAY LAYOUT)          -->
                            <!-- ======================================================== -->
                            <Grid x:Name="SlideNotifications" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- COLUMN 0: 3-Row Fundamental Layout (Same as File Tray) -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Title "Notify Center" + Compact Unread Count Pill -->
                                    <Grid Grid.Row="0" Margin="4,0,4,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Notify" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Center" FontSize="15" FontWeight="Bold" Foreground="#0A84FF" Margin="3,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Klik item untuk expand penuh" FontSize="9.5" Foreground="#636366" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#1E0A84FF" BorderBrush="#440A84FF" BorderThickness="1" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Stroke="#0A84FF" StrokeThickness="1.2" Width="9" Height="9" Stretch="Uniform" Fill="Transparent" Margin="0,0,4,0" VerticalAlignment="Center"
                                                          Data="M 6.5,1 C 4.5,1 3,2.5 3,4.5 V 8 L 1.5,10 H 11.5 L 10,8 V 4.5 C 10,2.5 8.5,1 6.5,1 Z M 5,11 C 5,11.8 5.7,12.5 6.5,12.5 C 7.3,12.5 8,11.8 8,11"/>
                                                    <TextBlock Text="{Binding UnreadNotificationCount, TargetNullValue='0'}" FontSize="10" FontWeight="Bold" Foreground="#0A84FF" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" Unread" FontSize="9.5" FontWeight="SemiBold" Foreground="#0A84FF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: Full-Width Scrollable Notification Cards Box (Height 92, same as File Tray) -->
                                    <Border Grid.Row="1"
                                            Background="#101014"
                                            BorderBrush="#1CFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,6"
                                            Height="92"
                                            Margin="4,0,4,10"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <!-- Empty State when no notifications -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal"
                                                        Visibility="{Binding HasNoNotifications, Converter={StaticResource BoolToVis}}">
                                                <Path Stroke="#8E8E93" StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Data="M 6.5,1 C 4.5,1 3,2.5 3,4.5 V 8 L 1.5,10 H 11.5 L 10,8 V 4.5 C 10,2.5 8.5,1 6.5,1 Z M 5,11 C 5,11.8 5.7,12.5 6.5,12.5 C 7.3,12.5 8,11.8 8,11"/>
                                                <TextBlock Text="Belum ada notifikasi masuk (klik 🔔 Test untuk uji notifikasi)" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <ScrollViewer x:Name="NotificationsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Notifications}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,2.5" CornerRadius="9" Padding="10,5.5" Cursor="Hand" MouseLeftButtonUp="OnNotificationCardClicked"
                                                                    ToolTip="Klik untuk expand &amp; membaca notifikasi penuh">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#16161C"/>
                                                                        <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Setter Property="Opacity" Value="1.0"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.72"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter Property="Background" Value="#20202A"/>
                                                                                <Setter Property="BorderBrush" Value="{Binding AccentHex}"/>
                                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#22222C"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- App Badge -->
                                                                    <Border Grid.Column="0" Background="{Binding AccentHex}" CornerRadius="5" Padding="6,2" Margin="0,1,10,0" VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding AppName}" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                    </Border>

                                                                    <!-- Title & Expandable Full Message (Full Horizontal Space) -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                                <Setter Property="TextTrimming" Value="None"/>
                                                                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="9" Foreground="#8E8E93" Margin="8,0,0,0" VerticalAlignment="Top"/>
                                                                        </Grid>

                                                                        <!-- Message (1-line preview when collapsed, full multi-line wrapped when expanded) -->
                                                                        <TextBlock Text="{Binding Message}" FontSize="10" Margin="0,2,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="#98989F"/>
                                                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Foreground" Value="#EBEBF5"/>
                                                                                            <Setter Property="TextTrimming" Value="None"/>
                                                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>

                                                                        <!-- Full Timestamp Footer when expanded -->
                                                                        <TextBlock Text="{Binding FormattedFullTime}" FontSize="8.5" Foreground="#636366" Margin="0,4,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <!-- Expand Indicator (▾/▴) & Dismiss Button (×) -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                                        <Border Background="#18FFFFFF" CornerRadius="8" Width="17" Height="17" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                ToolTip="Expand / Collapse">
                                                                            <TextBlock Text="{Binding ExpandIcon}" FontSize="9" Foreground="#C7C7CC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                                        </Border>
                                                                        <Button Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Width="17" Height="17"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Cursor="Hand"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip="Hapus notifikasi ini">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="Bd" Background="#24242A" CornerRadius="8.5">
                                                                                        <TextBlock Text="×" FontSize="10.5" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1.5,0,0"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="Bd" Property="Background" Value="#FF453A"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <!-- Row 2: Bottom Quick Action Buttons (File Tray Fundamental Style) -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                        <Button Click="OnExpandSelectedNotificationClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="📖 Expand Full" Margin="5,0" ToolTip="Expand / baca penuh notifikasi"/>
                                        <Button Command="{Binding ReadAllNotificationsCommand}" Style="{StaticResource DarkCapsuleButtonStyle}" Content="✓ Read All" Margin="5,0" ToolTip="Tandai semua sudah dibaca"/>
                                        <Button Click="OnTestToastClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="🔔 Test" Margin="5,0" ToolTip="Uji notifikasi sistem"/>
                                        <Button Click="OnClearAllNotificationsClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="🗑️ Hapus Semua" Foreground="#FF453A" Margin="5,0" ToolTip="Hapus semua notifikasi"/>
                                    </StackPanel>
                                </Grid>

                                <!-- COLUMN 1: Conditional Expandable Full Notification Reader Panel (Width 215) -->
                                <Border x:Name="NotificationDetailPanel"
                                        Grid.Column="1"
                                        Width="215"
                                        Height="152"
                                        Margin="10,0,0,0"
                                        Background="#121216"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12,9"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: App Badge + Time + Close Button -->
                                        <Grid Grid.Row="0" Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding SelectedNotification.AccentHex, FallbackValue='#0A84FF'}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedNotification.AppName, FallbackValue='Info'}" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedNotification.FormattedFullTime}" FontSize="8.5" Foreground="#8E8E93" Margin="7,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Click="OnCloseNotificationDetailClicked" Content="×" Width="18" Height="18" FontSize="12" Foreground="#8E8E93" Style="{StaticResource CleanMediaButtonStyle}" ToolTip="Tutup panel baca"/>
                                        </Grid>

                                        <!-- Full Notification Title -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SelectedNotification.Title}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="34"
                                                   Margin="0,0,0,4"/>

                                        <!-- Scrollable Full Notification Message Body -->
                                        <ScrollViewer x:Name="NotificationDetailScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding SelectedNotification.Message}"
                                                       FontSize="10"
                                                       Foreground="#D1D1D6"
                                                       TextWrapping="Wrap"
                                                       LineHeight="14.5"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ======================================================== -->
                            <!-- SLIDE 4: FILE TRAY / QUICK CONTROLS (TRAY MASUK)         -->
                            <!-- ======================================================== -->
                            <Grid x:Name="SlideFileDrop" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Title "File Tray" -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,6">
                                    <TextBlock Text="File" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Tray" FontSize="15" FontWeight="Bold" Foreground="#BF5AF2" Margin="3,0,0,0"/>
                                </StackPanel>

                                <!-- Row 1: Drop Box & Item List -->
                                <Border Grid.Row="1" Background="#101014" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,8" Height="92" Margin="4,0,4,10" VerticalAlignment="Center">
                                    <Grid>
                                        <!-- Empty State (Clickable to browse files) -->
                                        <Border x:Name="EmptyFilesView" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnBrowseFilesClicked" ToolTip="Drop files here or click to browse files">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Path Stroke="#8E8E93" StrokeThickness="1.2" Fill="Transparent" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Data="M 2,4 C 2,2.9 2.9,2 4,2 H 7 L 9,4 H 14 C 15.1,4 16,4.9 16,6 V 12 C 16,13.1 15.1,14 14,14 H 4 C 2.9,14 2,13.1 2,12 Z"/>
                                                <TextBlock x:Name="EmptyFilesText" Text="Drop files here to hold (or click to browse)" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Populated Items List -->
                                        <ScrollViewer x:Name="FilesListScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                            <ItemsControl ItemsSource="{Binding FileItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,10,0" Background="#1E1E24" BorderBrush="#383842" BorderThickness="1" CornerRadius="9"
                                                                Padding="10,5" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click and drag out to copy to other apps"
                                                                PreviewMouseLeftButtonDown="OnFileCardMouseDown"
                                                                PreviewMouseMove="OnFileCardMouseMove">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <StackPanel VerticalAlignment="Center" MaxWidth="95">
                                                                    <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding FileSizeFormatted}" FontSize="9" Foreground="#8E8E93" Margin="0,1,0,0"/>
                                                                </StackPanel>
                                                                <Button Command="{Binding DataContext.RemoveFileItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" Margin="8,0,0,0" Width="18" Height="18" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="#2A2A32" CornerRadius="9">
                                                                                <TextBlock Text="×" FontSize="10" Foreground="#C7C7CC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Bottom Quick Action Buttons with 10px gap -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <Button Click="OnBrowseFilesButtonClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="⊕ Add Files" Margin="5,0"/>
                                    <Button Click="OnCopyPngClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="📋 Copy PNG" Margin="5,0" ToolTip="Copy image/files to Clipboard or capture Clipboard image as PNG"/>
                                    <Button Click="OnZipFilesClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="📦 ZIP" Margin="5,0" ToolTip="Create ZIP archive on Desktop"/>
                                    <Button Click="OnClearFilesClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="Clear All" Margin="5,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ======================================================== -->
                            <!-- SLIDE 5: JADWAL SHOLAT BERDASARKAN LOKASI                -->
                            <!-- (Fundamental Layout: File Tray 3-Row Architecture)       -->
                            <!-- ======================================================== -->
                            <Grid x:Name="SlidePrayerTimes" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Title "Jadwal Sholat" + Current Location Badge on Top Right -->
                                <Grid Grid.Row="0" Margin="4,0,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Jadwal" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Sholat" FontSize="15" FontWeight="Bold" Foreground="#30D158" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <!-- Location Pill Badge Preserved on Top Right -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Click="OnEditPrayerCityClicked"
                                                Style="{StaticResource DarkCapsuleButtonStyle}"
                                                Padding="8,3"
                                                FontSize="9.5"
                                                ToolTip="Klik untuk mengubah kota lokasi jadwal sholat">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📍" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PrayerLocationText}" FontSize="9.5" Foreground="#EBEBF5" MaxWidth="175" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Text="✎" FontSize="8.5" Foreground="#8E8E93" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Full-Width 1-Line Prayer Schedule Container (Matches File Tray Box) -->
                                <Border x:Name="PrayerScheduleListBorder"
                                        Grid.Row="1"
                                        Background="#101014"
                                        BorderBrush="#1CFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="6,6"
                                        Height="92"
                                        Margin="4,0,4,10"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Sub-Header: Hijri Date (Left) & Next Prayer Live Countdown (Right) -->
                                        <Grid Grid.Row="0" Margin="4,0,4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding PrayerHijriDateText}"
                                                       FontSize="9"
                                                       Foreground="#8E8E93"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Berikutnya:" FontSize="9" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding NextPrayerName}" FontSize="9.5" FontWeight="Bold" Foreground="#30D158" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding NextPrayerTimeText}" FontSize="9.5" FontWeight="Bold" Foreground="#30D158" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="•" FontSize="9" Foreground="#636366" Margin="5,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding NextPrayerCountdownText}" FontSize="9" FontWeight="SemiBold" Foreground="#A8E6CF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- All Prayer Times Aligned in 1 Horizontal Line -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding PrayerTimes}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="1.5,0" CornerRadius="8" Padding="2,5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#0AFFFFFF"/>
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Background" Value="#2230D158"/>
                                                                        <Setter Property="BorderBrush" Value="#6630D158"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#18FFFFFF"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <!-- Prayer Name -->
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="9.5"
                                                                       HorizontalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#C7C7CC"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsObligatory}" Value="False">
                                                                                <Setter Property="Foreground" Value="#7C7C82"/>
                                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Foreground" Value="#30D158"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Prayer Time (HH:mm) -->
                                                            <TextBlock Text="{Binding TimeString}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,3,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsObligatory}" Value="False">
                                                                                <Setter Property="Foreground" Value="#8E8E93"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Foreground" Value="#30D158"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Active Ongoing Prayer Indicator Bar -->
                                                            <Border Width="16" Height="2.5" CornerRadius="1.25" Margin="0,4,0,0" HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Background" Value="#30D158"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Bottom Quick Action Capsule Buttons (Matches File Tray) -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <Button Click="OnEditPrayerCityClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="📍 Pilih Kota" Margin="5,0" ToolTip="Cari atau pilih kota lokasi sholat"/>
                                    <Button Click="OnAutoDetectPrayerLocationClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="🎯 Auto Lokasi" Margin="5,0" ToolTip="Deteksi lokasi otomatis berdasarkan IP"/>
                                    <Button Click="OnRefreshPrayerTimesClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="🔄 Segarkan" Margin="5,0" ToolTip="Muat ulang jadwal sholat hari ini"/>
                                </StackPanel>

                                <!-- Inline Location / City Search Panel (Spans Row 1 & Row 2 when open) -->
                                <Border x:Name="PrayerCityEditorPanel"
                                        Grid.Row="1"
                                        Grid.RowSpan="2"
                                        Height="132"
                                        Margin="4,0,4,0"
                                        Background="#14141A"
                                        BorderBrush="#30D158"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Pilih / Cari Kota Lokasi" FontSize="10.5" FontWeight="Bold" Foreground="#30D158" Margin="0,0,0,5"/>

                                        <!-- City Search TextBox -->
                                        <Border Background="#22222A" CornerRadius="6" Padding="7,4" Margin="0,0,0,6">
                                            <TextBox x:Name="TxtPrayerCityInput"
                                                     FontSize="11"
                                                     Foreground="#FFFFFF"
                                                     CaretBrush="#30D158"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     KeyDown="OnPrayerCityKeyDown"
                                                     ToolTip="Ketik nama kota (contoh: Jakarta, Bandung, Surabaya, Denpasar, Makassar)"/>
                                        </Border>

                                        <!-- Quick City Chips -->
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button Click="OnQuickPrayerCityClicked" Tag="Jakarta" Content="Jakarta" Style="{StaticResource DarkCapsuleButtonStyle}" Padding="7,2" FontSize="8.5" Margin="0,0,4,3"/>
                                            <Button Click="OnQuickPrayerCityClicked" Tag="Bandung" Content="Bandung" Style="{StaticResource DarkCapsuleButtonStyle}" Padding="7,2" FontSize="8.5" Margin="0,0,4,3"/>
                                            <Button Click="OnQuickPrayerCityClicked" Tag="Surabaya" Content="Surabaya" Style="{StaticResource DarkCapsuleButtonStyle}" Padding="7,2" FontSize="8.5" Margin="0,0,4,3"/>
                                            <Button Click="OnQuickPrayerCityClicked" Tag="Yogyakarta" Content="Yogya" Style="{StaticResource DarkCapsuleButtonStyle}" Padding="7,2" FontSize="8.5" Margin="0,0,4,3"/>
                                            <Button Click="OnQuickPrayerCityClicked" Tag="Denpasar" Content="Denpasar" Style="{StaticResource DarkCapsuleButtonStyle}" Padding="7,2" FontSize="8.5" Margin="0,0,4,3"/>
                                            <Button Click="OnQuickPrayerCityClicked" Tag="Makassar" Content="Makassar" Style="{StaticResource DarkCapsuleButtonStyle}" Padding="7,2" FontSize="8.5" Margin="0,0,4,3"/>
                                        </WrapPanel>

                                        <!-- Save / Cancel Buttons -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Click="OnCancelPrayerCityClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="Batal" Padding="9,3" FontSize="9.5" Margin="0,0,6,0"/>
                                            <Button Click="OnSavePrayerCityClicked" Style="{StaticResource DarkCapsuleButtonStyle}" Content="✓ Simpan" Foreground="#30D158" Padding="9,3" FontSize="9.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Right Chevron Button (>) -->
                        <Button x:Name="NextSlideBtn"
                                Grid.Column="2"
                                Style="{StaticResource CarouselChevronButtonStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="OnNextSlideClicked"
                                ToolTip="Next Slide">
                            <Path Data="M 9,6 L 14,11 L 9,16"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>

                    <!-- ROW 2: MORPHING BOTTOM DOCK (PAGINATION DOTS <-> 6-ICON DOCK) (Height 32) -->
                    <Grid Grid.Row="2"
                          x:Name="BottomDockHost"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,4"
                          Height="24"
                          Background="Transparent"
                          MouseEnter="OnBottomDockMouseEnter"
                          MouseLeave="OnBottomDockMouseLeave">

                        <!-- State 1: Pagination Dots (6 Indicators, Default terlihat) -->
                        <StackPanel x:Name="PaginationDotsPanel" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Dot 0 (Music - Default Active) -->
                            <Border x:Name="Dot0" Width="16" Height="4" CornerRadius="2" Background="#FFFFFF" Margin="4,0" Cursor="Hand" MouseLeftButtonUp="OnDotClicked" Tag="0"/>
                            <!-- Dot 1 (Pomodoro) -->
                            <Border x:Name="Dot1" Width="4" Height="4" CornerRadius="2" Background="#55FFFFFF" Margin="4,0" Cursor="Hand" MouseLeftButtonUp="OnDotClicked" Tag="1"/>
                            <!-- Dot 2 (TodoList) -->
                            <Border x:Name="Dot2" Width="4" Height="4" CornerRadius="2" Background="#55FFFFFF" Margin="4,0" Cursor="Hand" MouseLeftButtonUp="OnDotClicked" Tag="2"/>
                            <!-- Dot 3 (Notifications) -->
                            <Border x:Name="Dot3" Width="4" Height="4" CornerRadius="2" Background="#55FFFFFF" Margin="4,0" Cursor="Hand" MouseLeftButtonUp="OnDotClicked" Tag="3"/>
                            <!-- Dot 4 (File Tray) -->
                            <Border x:Name="Dot4" Width="4" Height="4" CornerRadius="2" Background="#55FFFFFF" Margin="4,0" Cursor="Hand" MouseLeftButtonUp="OnDotClicked" Tag="4"/>
                            <!-- Dot 5 (Jadwal Sholat) -->
                            <Border x:Name="Dot5" Width="4" Height="4" CornerRadius="2" Background="#55FFFFFF" Margin="4,0" Cursor="Hand" MouseLeftButtonUp="OnDotClicked" Tag="5"/>
                        </StackPanel>

                        <!-- State 2: BottomIconDockPanel (6 Tombol Ikon Vektor, muncul saat di-hover) -->
                        <Border x:Name="BottomIconDockBorder"
                                Background="#E618181C"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Opacity="0"
                                Visibility="Collapsed">
                            <StackPanel x:Name="BottomIconDockPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 1. Music Icon (Not Musik) - #FF2D55 saat aktif -->
                                <Button Click="OnDockBtnClicked" Tag="0" Style="{StaticResource MicroDockButtonStyle}" ToolTip="Music Player">
                                    <Path x:Name="DockMusicIcon" Fill="#FF2D55" Width="12" Height="12" Stretch="Uniform"
                                          Data="M 9,3 V 10 C 9,11.1 8.1,12 7,12 C 5.9,12 5,11.1 5,10 C 5,8.9 5.9,8 7,8 C 7.4,8 7.7,8.1 8,8.3 V 5 L 13,3.5 V 9 C 13,10.1 12.1,11 11,11 C 9.9,11 9,10.1 9,9 C 9,7.9 9.9,7 11,7 C 11.4,7 11.7,7.1 12,7.3 V 2 Z"/>
                                </Button>

                                <!-- 2. Pomodoro Icon (Stopwatch) - #FF453A saat aktif -->
                                <Button Click="OnDockBtnClicked" Tag="1" Style="{StaticResource MicroDockButtonStyle}" ToolTip="Pomodoro Timer">
                                    <Path x:Name="DockPomodoroIcon" Stroke="#8E8E93" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                          Data="M 5,1 H 9 M 7,1 V 3 M 7,5 V 8 L 9,8 M 7,3 A 5,5 0 1,1 6.99,3 Z"/>
                                </Button>

                                <!-- 3. TodoList Icon (Checklist) - #30D158 saat aktif -->
                                <Button Click="OnDockBtnClicked" Tag="2" Style="{StaticResource MicroDockButtonStyle}" ToolTip="Todo List &amp; Calendar">
                                    <Path x:Name="DockTodoIcon" Stroke="#8E8E93" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                          Data="M 2,4 C 2,2.9 2.9,2 4,2 H 10 C 11.1,2 12,2.9 12,4 V 10 C 12,11.1 11.1,12 10,12 H 4 C 2.9,12 2,11.1 2,10 Z M 4,7 L 6,9 L 10,4"/>
                                </Button>

                                <!-- 4. Notification Icon (Lonceng) - #0A84FF saat aktif -->
                                <Button Click="OnDockBtnClicked" Tag="3" Style="{StaticResource MicroDockButtonStyle}" ToolTip="Notifications">
                                    <Grid>
                                        <Path x:Name="DockNotifyIcon" Stroke="#8E8E93" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                              Data="M 6,1 C 4.5,1 3,2.2 3,4 V 7 L 1.5,8.5 H 10.5 L 9,7 V 4 C 9,2.2 7.5,1 6,1 Z M 4.5,9.5 C 4.5,10.3 5.2,11 6,11 C 6.8,11 7.5,10.3 7.5,9.5"/>
                                        <!-- Unread Badge Dot -->
                                        <Border Width="4" Height="4" CornerRadius="2" Background="#FF3B30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                                Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>

                                <!-- 5. File Tray Icon (Tray Masuk) - #BF5AF2 saat aktif -->
                                <Button Click="OnDockBtnClicked" Tag="4" Style="{StaticResource MicroDockButtonStyle}" ToolTip="File Tray">
                                    <Path x:Name="DockFileTrayIcon" Stroke="#8E8E93" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                          Data="M 2,3 H 12 V 7 L 10,9 H 4 L 2,7 Z M 2,7 V 11 H 12 V 7"/>
                                </Button>

                                <!-- 6. Jadwal Sholat Icon (Crescent Moon & Star) - #30D158 saat aktif -->
                                <Button Click="OnDockBtnClicked" Tag="5" Style="{StaticResource MicroDockButtonStyle}" ToolTip="Jadwal Sholat">
                                    <Path x:Name="DockPrayerIcon" Stroke="#8E8E93" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                          Data="M 9.5,2.2 A 4.8,4.8 0 1,0 11.8,9.5 A 3.8,3.8 0 1,1 9.5,2.2 Z M 10.5,4.2 L 11.5,4.2 M 11,3.7 L 11,4.7"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
